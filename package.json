{
  "name": "Altayar",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:no-packager": "react-native run-android --no-packager",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "npx metro start --host 0.0.0.0",
    "start:reset": "npx metro start --reset-cache --host 0.0.0.0",
    "start:metro": "npx metro start --reset-cache --host 0.0.0.0",
    "start:dev": "adb reverse tcp:8081 tcp:8081 && npx metro start --reset-cache --host 0.0.0.0",
    "install:webview": "node install-webview.js",
    "deps:legacy": "npm install --legacy-peer-deps",
    "install:video": "npm install react-native-video@^5.2.1 --save --legacy-peer-deps",
    "audit:fix": "npm audit fix --legacy-peer-deps",
    "fix:video": "node -e \"console.log('Running fix-video-native-module.bat...'); require('child_process').exec('fix-video-native-module.bat', (err, stdout, stderr) => { if (err) console.error(err); else console.log(stdout); });\"",
    "fix:video:manual": "npm run install:video && cd android && gradlew.bat clean && cd .. && npx react-native run-android",
    "rebuild:android": "node rebuild-android.js",
    "clean": "node clean-android.js",
    "clean:build": "node clean-android.js",
    "clean:gradle": "cd android && .\\gradlew.bat clean && cd ..",
    "clean:all": "node -e \"require('fs').rmSync('node_modules/.cache', {recursive: true, force: true});\" && cd android && gradlew clean && cd ..",
    "test": "jest",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "cd ios && xcodebuild -workspace Altayar.xcworkspace -scheme Altayar -configuration Release -destination generic/platform=iOS -archivePath Altayar.xcarchive archive",
    "postinstall": "patch-package && node apply-video-patch.js && node scripts/ensure-codegen-stubs.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-navigation/bottom-tabs": "^7.8.1",
    "@react-navigation/drawer": "^7.7.2",
    "@react-navigation/native": "^7.1.19",
    "@react-navigation/stack": "^7.6.2",
    "@tanstack/react-query": "^5.90.7",
    "axios": "^1.13.2",
    "react": "^19.1.1",
    "react-native": "0.82.1",
    "react-native-fast-image": "^8.6.3",
    "react-native-gesture-handler": "^2.29.1",
    "react-native-image-picker": "^7.1.2",
    "react-native-qrcode-svg": "^6.3.20",
    "react-native-reanimated": "^4.1.3",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.18.0",
    "react-native-svg": "^15.14.0",
    "react-native-toast-message": "^2.3.3",
    "react-native-vector-icons": "^10.3.0",
    "react-native-video": "^5.2.2",
    "react-native-webview": "^13.16.0",
    "react-native-worklets": "^0.6.1",
    "socket.io-client": "^4.8.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/runtime": "^7.28.4",
    "@react-native-community/cli": "^20.0.2",
    "@react-native-community/cli-platform-android": "^20.0.2",
    "@react-native-community/cli-platform-ios": "^20.0.2",
    "@react-native/babel-preset": "^0.82.1",
    "@react-native/eslint-config": "^0.82.1",
    "@react-native/gradle-plugin": "^0.82.1",
    "@react-native/metro-config": "^0.82.1",
    "@react-native/typescript-config": "^0.82.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.2",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "babel-jest": "^30.2.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.39.1",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-react-native": "^5.0.0",
    "jest": "^30.2.0",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^3.6.2",
    "react-test-renderer": "^19.1.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
