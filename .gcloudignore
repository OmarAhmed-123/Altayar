# This file specifies files that are *not* uploaded to Google Cloud
# using gcloud. It follows the same syntax as .gitignore

# Node modules
node_modules/
npm-debug.log
yarn-error.log

# Environment files
.env
.env.local
.env.*.local

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Git
.git/
.gitignore
.gitattributes

# Documentation
*.md
!README.md

# Scripts (not needed in container)
*.ps1
*.bat
*.sh
*.yaml
!cloudbuild.yaml
!Dockerfile
!knexfile.js

# Test files
test/
tests/
*.test.js
*.spec.js
coverage/

# Logs
logs/
*.log

# Temporary files
tmp/
temp/
*.tmp

# Build artifacts (will be rebuilt)
dist/
build/
.next/
out/

# Database files
*.sql
*.db
*.sqlite

# Docker files (not needed in build context)
docker-compose.yml
docker-compose.*.yml
.dockerignore

# Cloud Build files (keep cloudbuild.yaml - needed for build)
.gcloudignore
# Keep cloudbuild.yaml - it's needed!

# Migration files (keep these - needed for migrations)
# migrations/ - KEEP THIS

# Other
.cache/
.npm/
.yarn/

# Uploads directory (may contain large files)
uploads/*
!uploads/.gitkeep

# IMPORTANT: Memberships directory - INCLUDE all PDFs for the membership features
# DO NOT exclude these files - they are needed for membership PDF display
# memberships/*
# !memberships/.gitkeep

# Assets directory - fonts for PDF generation
# Keep fonts for Arabic text support
!assets/fonts/
!assets/fonts/**

# All markdown documentation files
*.md
!README.md

# All documentation and guide files
