# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=StrongPass123
DB_NAME=tourist_app_db

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here-make-it-very-long-and-secure
SESSION_SECRET=your-super-secret-session-key-here-make-it-very-long-and-secure

# Server Configuration
PORT=5000
NODE_ENV=development

# Default Admin Bootstrap (optional)
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change-me-strong-password
DEFAULT_ADMIN_NAME=Altayar Admin
AUTO_BOOTSTRAP_SUPER_ADMIN=true

# Frontend URL
FRONTEND_URL=http://localhost:3000

# OAuth Configuration (Optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
APPLE_CLIENT_ID=your-apple-client-id
APPLE_CLIENT_SECRET=your-apple-client-secret

# External API Keys (Optional)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
WEATHER_API_KEY=your-weather-api-key
EXCHANGE_RATE_API_KEY=your-exchange-rate-api-key

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# SMS Configuration (Optional)
SMS_API_KEY=your-sms-api-key
SMS_API_SECRET=your-sms-api-secret

# Fawaterak Payment Gateway Configuration
# Integration URL: https://app.fawaterk.com/vendor/integration
FAWATERAK_API_KEY=your-fawaterak-api-key
FAWATERAK_PROVIDER_KEY=your-fawaterak-provider-key
FAWATERAK_BASE_URL=https://fawaterak.com/api/v2

# Public URL for payment callbacks (use your LAN/IP in dev)
BACKEND_URL=http://192.168.1.4:5000

# Deep Links & Firebase Dynamic Links Configuration
DEEP_LINK_BASE_URL=https://altayar.com
LANDING_PAGE_URL=https://altayar.com
FIREBASE_PROJECT_ID=altayar-46d6f
FIREBASE_DYNAMIC_LINKS_DOMAIN=altayar.page.link
# Firebase API Key for Dynamic Links (get from Firebase Console > Project Settings > General)
# Web API Key: AIzaSyDb8dnWaKP06_ZOuYnHzvMMII9hotW83D8
FIREBASE_API_KEY=AIzaSyDb8dnWaKP06_ZOuYnHzvMMII9hotW83D8
# Android & iOS App Configuration
ANDROID_PACKAGE_NAME=com.example.Altayar
IOS_BUNDLE_ID=com.example.Altayar
IOS_APP_STORE_ID=your-ios-app-store-id
