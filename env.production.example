# Production Environment Variables for Google Cloud
# Copy this file to .env and fill in the actual values

# Database Configuration (Cloud SQL)
# Format: /cloudsql/PROJECT_ID:REGION:INSTANCE_NAME
# Or use: DB_HOST=/cloudsql/altayarback:us-central1:altayar-db
DB_HOST=/cloudsql/altayarback:us-central1:altayar-db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=YOUR_SECURE_PASSWORD_HERE
DB_NAME=tourist_app_db

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here-make-it-very-long-and-secure-change-this-in-production
SESSION_SECRET=your-super-secret-session-key-here-make-it-very-long-and-secure-change-this-in-production

# Server Configuration
PORT=8080
NODE_ENV=production

# Frontend URL (Update with your deployed frontend URL)
FRONTEND_URL=https://your-frontend-domain.com,https://your-app-domain.com

# OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
APPLE_CLIENT_ID=your-apple-client-id
APPLE_CLIENT_SECRET=your-apple-client-secret

# External API Keys
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
WEATHER_API_KEY=your-weather-api-key
EXCHANGE_RATE_API_KEY=your-exchange-rate-api-key

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# SMS Configuration
SMS_API_KEY=your-sms-api-key
SMS_API_SECRET=your-sms-api-secret

# Fawaterak Payment Gateway Configuration
FAWATERAK_API_KEY=your-fawaterak-api-key
FAWATERAK_PROVIDER_KEY=your-fawaterak-provider-key
FAWATERAK_BASE_URL=https://fawaterak.com/api/v2

# Public URL for payment callbacks (Update with your Cloud Run URL)
BACKEND_URL=https://altayar-backend-xxxxx-uc.a.run.app

# Deep Links & Firebase Dynamic Links Configuration
DEEP_LINK_BASE_URL=https://altayar.com
LANDING_PAGE_URL=https://altayar.com
FIREBASE_PROJECT_ID=altayar-46d6f
FIREBASE_DYNAMIC_LINKS_DOMAIN=altayar.page.link
FIREBASE_API_KEY=AIzaSyDb8dnWaKP06_ZOuYnHzvMMII9hotW83D8

# Android & iOS App Configuration
ANDROID_PACKAGE_NAME=com.example.Altayar
IOS_BUNDLE_ID=com.example.Altayar
IOS_APP_STORE_ID=your-ios-app-store-id

