@echo off
setlocal enabledelayedexpansion

echo ========================================
echo 🚀 تشغيل الباكند بشكل كامل
echo ========================================
echo.

cd /d "%~dp0"

REM ========================================
REM الخطوة 1: إصلاح الاتصال بقاعدة البيانات
REM ========================================
echo ✅ الخطوة 1: إصلاح الاتصال بقاعدة البيانات...
call FIX_DB_CONNECTION_COMPLETE.bat
if %errorlevel% neq 0 (
    echo ❌ فشل إصلاح الاتصال بقاعدة البيانات
    pause
    exit /b 1
)

REM ========================================
REM الخطوة 2: تثبيت الحزم (إذا لزم الأمر)
REM ========================================
echo.
echo ✅ الخطوة 2: التحقق من الحزم...
if not exist "node_modules" (
    echo ⚠️  node_modules غير موجود. جاري التثبيت...
    call npm install
    if %errorlevel% neq 0 (
        echo ❌ فشل تثبيت الحزم
        pause
        exit /b 1
    )
)

REM ========================================
REM الخطوة 3: تشغيل الباكند
REM ========================================
echo.
echo ✅ الخطوة 3: تشغيل الباكند...
echo.
echo ========================================
echo 🚀 الباكند يعمل الآن
echo ========================================
echo.
echo 📡 API متاح على:
echo    http://localhost:5000/api
echo    http://192.168.1.4:5000/api
echo.
echo 💡 اضغط Ctrl+C لإيقاف الباكند
echo.
echo ========================================
echo.

call npm start

